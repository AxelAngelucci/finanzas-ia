{
  "expo": {
    "name": "Finia",
    "slug": "finanzas-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "finanzas-ia",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finanzasai.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger tu información financiera.",
        "NSCameraUsageDescription": "Usamos la cámara para fotografiar comprobantes y facturas.",
        "NSPhotoLibraryUsageDescription": "Adjuntá fotos de tickets y facturas para registrarlos automáticamente.",
        "NSMicrophoneUsageDescription": "Grabá notas de voz para registrar gastos por audio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "package": "com.finanzasai.app",
      "permissions": [
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#6366F1"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Usamos Face ID para proteger tu información financiera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://beautiful-optimism-production.up.railway.app/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c5c3d14c-837e-4429-b0f4-08869ff16277"
      },
      "rcIosKey": "appl_tBcHeOLNtWHKQSblXhRWxOlOOsj",
      "rcAndroidKey": "goog_pmdHxcUzPxFGUVGpyueNbyJuWLW"
    },
    "owner": "axeljesusangelucci"
  }
}
